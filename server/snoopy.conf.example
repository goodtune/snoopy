# Snoopy configuration, read by the systemd user unit (snoopy.service) from
#   /etc/snoopy/snoopy.conf            (all users)
#   ~/.config/snoopy/snoopy.conf       (your user; overrides the above)
# Each SNOOPY_* variable sets the default of the matching command-line flag;
# a flag given on the command line still wins. Values shown are the built-in
# defaults. Uncomment and edit, then: systemctl --user restart snoopy.service

# Managed mode (system-wide /etc/snoopy/snoopy.conf only; ignored elsewhere).
# For supervised desktops: the settings in this file become final. Snoopy
# then ignores ~/.config/snoopy/snoopy.conf, every other SNOOPY_* environment
# variable and command-line flags, using only this file plus the built-in
# defaults, and logs the names of the settings it ignored. It only takes
# effect if this file is owned by root and not group- or world-writable
# (sudo chown root:root /etc/snoopy/snoopy.conf && sudo chmod 0644 ...);
# otherwise snoopy logs a warning and runs unmanaged. Invalid values here
# stop snoopy with exit status 2.
# SNOOPY_MANAGED=1

# WARNING: Snoopy has no authentication. 0.0.0.0 serves live screenshots to
# anyone who can reach the port and advertises the server over mDNS. Only do
# this on a trusted LAN (it is required for the mobile app to find the server).
# SNOOPY_ADDR=0.0.0.0

# HTTP bind address (loopback: not reachable from other machines, no mDNS).
#SNOOPY_ADDR=127.0.0.1
#SNOOPY_PORT=8900

# Recording. An empty SNOOPY_OUT means ~/.cache/snoopy/video.
#SNOOPY_OUT=
#SNOOPY_SEGMENT=30m
#SNOOPY_PAUSE=1s
#SNOOPY_TEMPLATE=screen-%d-%t.webm
#SNOOPY_HEALTH_CHECK=15s
# Restart the segment if its file has not grown for this long while the
# session is unlocked (fallback for missed lock/resume events); 0 disables.
# A static screen grows the file slowly, so keep this to minutes.
#SNOOPY_STALL_TIMEOUT=5m

# Live frames for the web page and mobile app.
#SNOOPY_IMAGE_INTERVAL=5s
#SNOOPY_IMAGE_CACHE_SIZE=100
