[Unit]
Description=Snoopy - Continuous screen recording with web streaming
Documentation=https://github.com/goodtune/snoopy
# Only run inside a graphical (GNOME) session, and stop with it. Binding to
# default.target would also start it on SSH/TTY logins where GNOME Shell is
# not on the session bus, causing a restart loop.
PartOf=graphical-session.target
After=graphical-session.target
# Allow up to 10 restarts in 5 minutes so a locked or suspended session does
# not permanently trip the start limit.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Optional SNOOPY_* settings (see /usr/share/doc/snoopy/snoopy.conf.example);
# the per-user file is read last, so it overrides the system-wide one.
# Snoopy binds 127.0.0.1 by default. To expose it on the LAN (and advertise it
# over mDNS for the mobile app), as your user:
#   mkdir -p ~/.config/snoopy && echo 'SNOOPY_ADDR=0.0.0.0' >> ~/.config/snoopy/snoopy.conf && systemctl --user restart snoopy.service
EnvironmentFile=-/etc/snoopy/snoopy.conf
EnvironmentFile=-%h/.config/snoopy/snoopy.conf
ExecStart=/usr/bin/snoopy
# Restart on failure (non-zero exit code) such as when DBus connection is lost
# This allows the service to recover from session pause/lock events
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
